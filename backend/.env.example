# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=document_intelligence
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/document_intelligence
SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/document_intelligence

# Redis / Queue configuration
REDIS_URL=redis://redis:6379/0

# Security
JWT_SECRET=super-secret-jwt-signing-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MinIO / S3 Object Storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=documents
S3_SECURE=False

# AI Model Provider API keys
GEMINI_API_KEY=your_gemini_api_key_here
